{
  "schemaVersion": 1,
  "window": {
    "title": "TimeMaxx Frame",
    "width": 960,
    "height": 960,
    "minWidth": 760,
    "minHeight": 700,
    "background": "#111418",
    "caption": { "mode": "custom" }
  },
  "document": { "scale": 1, "x": 0, "y": 0, "rotation": 0 },
  "history": { "limit": 60 },
  "rotation": { "min": -180, "max": 180, "step": 0.1, "precision": 1, "buttonStep": 90 },
  "output": {
    "frame": { "width": 1200, "height": 1600 },
    "exports": [{ "width": 1200, "height": 1600 }, { "width": 2400, "height": 3200 }, { "width": 3024, "height": 4032 }],
    "defaultWidth": 1200,
    "previewMaxEdge": 1400,
    "jpegQuality": 95,
    "matte": [0, 0, 0]
  },
  "presets": {
    "base": {
      "colors": { "background": "transparent", "foreground": "#e4e9ef", "border": "transparent", "outline": "transparent" },
      "geometry": { "paddingX": 0, "paddingY": 0, "gap": 0, "radius": 0, "borderWidth": 0, "borderStyle": "solid", "outlineWidth": 0, "outlineStyle": "solid", "outlineOffset": 0, "iconWidth": 60, "iconHeight": 60, "fontSize": 12, "lineHeight": 1.3, "letterSpacing": 0, "opacity": 1, "shadow": "none", "transition": "none" },
      "typography": { "family": "\"Segoe UI\", system-ui, sans-serif", "weight": 400 },
      "content": { "direction": "row", "verticalAlign": "center", "horizontalAlign": "center", "textAlign": "center", "whiteSpace": "nowrap", "overflow": "hidden", "wrap": "nowrap" }
    },
    "bar": { "preset": "base", "colors": { "background": "#171c22", "border": "#2b333d" }, "geometry": { "borderWidth": 1 } },
    "button": {
      "preset": "base",
      "colors": { "background": "#1d252f", "border": "#43505f" },
      "geometry": { "borderWidth": 1, "radius": 6 },
      "states": {
        "hover": { "colors": { "background": "#303d4c", "border": "#8292a6" } },
        "focusVisible": { "colors": { "outline": "#ffc44d" }, "geometry": { "outlineWidth": 2 } },
        "disabled": { "colors": { "foreground": "#687381", "background": "#171c22", "border": "#303842" } }
      }
    },
    "fileAction": { "preset": "button", "colors": { "background": "transparent" }, "geometry": { "iconWidth": 49, "iconHeight": 62 } },
    "rotationField": { "preset": "button", "colors": { "background": "transparent" } },
    "rotationValue": { "preset": "base", "geometry": { "fontSize": 13 }, "states": { "focusVisible": { "colors": { "outline": "#ffc44d" }, "geometry": { "outlineWidth": 1 } }, "error": { "colors": { "foreground": "#ff9f9f" } } } },
    "rotationRail": { "preset": "base", "colors": { "background": "#43505f" }, "geometry": { "radius": 3 } },
    "rotationTrack": { "preset": "base", "colors": { "background": "#9aa5b2" }, "geometry": { "radius": 3 } },
    "rotationThumb": { "preset": "button", "colors": { "background": "#e4e9ef" }, "geometry": { "radius": 20 }, "states": { "active": { "colors": { "background": "#ffc44d" } } } },
    "fileName": { "preset": "base", "colors": { "foreground": "#9aa5b2" }, "content": { "horizontalAlign": "flex-start", "textAlign": "left" } },
    "status": { "preset": "base", "colors": { "foreground": "#9aa5b2" }, "content": { "whiteSpace": "normal", "horizontalAlign": "flex-start", "textAlign": "left" } },
    "inspector": { "preset": "base", "colors": { "border": "#df8af5" }, "geometry": { "borderWidth": 1 } },
    "inspectorLabel": { "preset": "base", "colors": { "background": "transparent", "foreground": "#f2d3ff" }, "geometry": { "fontSize": 10 }, "content": { "whiteSpace": "normal", "horizontalAlign": "flex-start", "verticalAlign": "flex-start", "textAlign": "left" } },
    "diagnostic": { "preset": "base", "colors": { "background": "#352b13", "foreground": "#ffe2a0", "border": "#826a2d" }, "geometry": { "borderWidth": 1 }, "content": { "whiteSpace": "normal", "horizontalAlign": "flex-start", "textAlign": "left" } }
  },
  "sections": [
    { "id": "windowsBar", "parentId": "window", "label": "Windows bar", "folder": "windows-bar", "enabled": true, "nativeSafeArea": false, "draggable": true, "bounds": { "x": 0, "y": 0, "width": 100, "height": 5 }, "preset": "bar" },
    { "id": "actionBar", "parentId": "window", "label": "Action bar", "folder": "action-bar", "enabled": true, "nativeSafeArea": false, "draggable": false, "bounds": { "x": 0, "y": 5, "width": 100, "height": 5 }, "preset": "bar" },
    { "id": "frameBody", "parentId": "window", "label": "Frame body", "folder": "frame-body", "enabled": true, "nativeSafeArea": false, "draggable": false, "bounds": { "x": 0, "y": 10, "width": 100, "height": 83 }, "preset": "base", "colors": { "background": "#0e1116" } },
    { "id": "bottomBar", "parentId": "window", "label": "Bottom bar", "folder": "bottom-bar", "enabled": true, "nativeSafeArea": false, "draggable": false, "bounds": { "x": 0, "y": 93, "width": 100, "height": 7 }, "preset": "bar" }
