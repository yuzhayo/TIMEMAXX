    { "id": "redo", "componentId": "history.redo", "parentId": "windowsBar", "enabled": true, "label": "Redo", "bounds": { "x": 7, "y": 8, "width": 4.5, "height": 84 }, "preset": "button" },
    { "id": "load", "componentId": "file.action", "parentId": "actionBar", "enabled": true, "label": "Load image", "action": "load", "icon": "folderOpen", "bounds": { "x": 81, "y": 8, "width": 8, "height": 84 }, "preset": "fileAction" },
    { "id": "save", "componentId": "file.action", "parentId": "actionBar", "enabled": true, "label": "Save image", "action": "save", "icon": "save", "bounds": { "x": 90, "y": 8, "width": 8, "height": 84 }, "preset": "fileAction" },
    { "id": "fileName", "componentId": "photo.fileName", "parentId": "windowsBar", "enabled": true, "label": "Current image", "bounds": { "x": 13, "y": 15, "width": 64, "height": 70 }, "preset": "fileName", "interaction": { "pointerEvents": "none", "dragRegion": "inherit" } },
    { "id": "photoPreview", "componentId": "photo.preview", "parentId": "frameBody", "enabled": true, "label": "Photo preview", "bounds": { "x": 0, "y": 0, "width": 100, "height": 100 }, "preset": "base", "presentation": { "insetX": 1, "insetY": 1 }, "colors": { "border": "#64707b" }, "geometry": { "borderWidth": 1 } },
    { "id": "fileStatus", "componentId": "file.status", "parentId": "bottomBar", "enabled": true, "label": "File operation status", "bounds": { "x": 2, "y": 10, "width": 96, "height": 80 }, "preset": "status" },
    { "id": "windowMinimize", "componentId": "window.action", "parentId": "windowsBar", "enabled": true, "label": "Minimize window", "action": "minimize", "icon": "minimize", "bounds": { "x": 81, "y": 8, "width": 4.5, "height": 84 }, "preset": "fileAction" },
    { "id": "windowMaximize", "componentId": "window.action", "parentId": "windowsBar", "enabled": true, "label": "Maximize or restore window", "action": "toggleMaximize", "icon": "maximize", "maximizedIcon": "restore", "bounds": { "x": 87, "y": 8, "width": 4.5, "height": 84 }, "preset": "fileAction" },
    { "id": "windowClose", "componentId": "window.action", "parentId": "windowsBar", "enabled": true, "label": "Close window", "action": "close", "icon": "close", "bounds": { "x": 93, "y": 8, "width": 4.5, "height": 84 }, "preset": "fileAction" },
    { "id": "rotationControls", "componentId": "photo.rotationControls", "parentId": "actionBar", "enabled": true, "label": "Photo rotation controls", "unit": "°", "textSizing": { "minDigits": 1, "maxCharacters": 6, "paddingCh": 0.25, "gapCh": 0.2 }, "icons": { "left": "rotateLeft", "right": "rotateRight" },
      "labels": { "left": "Rotate left 90 degrees", "input": "Photo rotation in degrees", "slider": "Photo rotation slider", "right": "Rotate right 90 degrees", "separator": "Rotation group separator" },
      "bounds": { "x": 1, "y": 4, "width": 44, "height": 92 }, "preset": "base", "colors": { "outline": "#64707b" }, "geometry": { "outlineWidth": 1, "outlineStyle": "solid", "outlineOffset": 0, "paddingX": 2, "paddingY": 4 }, "parts": {
      "left": { "preset": "fileAction", "bounds": { "x": 0, "y": 0, "width": 11, "height": 100 }, "aspectRatio": 1 },
      "field": { "preset": "rotationField", "bounds": { "x": 13, "y": 0, "width": 16, "height": 100 } },
      "input": { "preset": "rotationValue", "size": { "width": 100, "height": 84 }, "content": { "textAlign": "right" } },
      "degree": { "preset": "rotationValue", "size": { "width": 100, "height": 84 } },
      "slider": { "preset": "base", "bounds": { "x": 30, "y": 0, "width": 50, "height": 100 } },
      "control": { "preset": "base", "bounds": { "x": 6, "y": 0, "width": 88, "height": 100 }, "content": { "overflow": "visible" } },
      "rail": { "preset": "rotationRail", "size": { "width": 100, "height": 12 } },
      "track": { "preset": "rotationTrack", "size": { "width": 100, "height": 12 } },
      "thumb": { "preset": "rotationThumb", "size": { "width": 8, "height": 48 } },
      "right": { "preset": "fileAction", "bounds": { "x": 82, "y": 0, "width": 11, "height": 100 }, "aspectRatio": 1 },
      "separator": { "preset": "base", "bounds": { "x": 96, "y": 18, "width": 0.4, "height": 64 }, "colors": { "background": "#43505f" } }
    } }
  ],
  "diagnostics": { "preset": "diagnostic", "bounds": { "x": 2, "y": 82, "width": 96, "height": 9 } },
  "development": {
    "inspectionEnabled": false,
    "inspector": { "preset": "inspector" },
    "label": { "preset": "inspectorLabel", "bounds": { "x": 0, "y": 0, "width": 100, "height": 45 } },
    "summary": { "preset": "inspectorLabel", "bounds": { "x": 2, "y": 40, "width": 96, "height": 40 }, "colors": { "background": "#261b32ee" }, "geometry": { "fontSize": 12 }, "content": { "direction": "column" } }
  }
}
