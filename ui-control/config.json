      "toLabel": { "preset": "captionText", "label": "To", "bounds": { "x": 55, "y": 0, "width": 45, "height": 10 } },
      "from": { "preset": "timeField", "label": "From time", "bounds": { "x": 0, "y": 12, "width": 45, "height": 18 } },
      "to": { "preset": "timeField", "label": "To time", "bounds": { "x": 55, "y": 12, "width": 45, "height": 18 } },
      "generate": { "preset": "primaryAction", "label": "Generate time", "bounds": { "x": 0, "y": 36, "width": 47, "height": 16 } },
      "copy": { "preset": "secondaryAction", "label": "Copy time", "bounds": { "x": 53, "y": 36, "width": 47, "height": 16 } },
      "h24": { "preset": "choice", "label": "24h", "bounds": { "x": 0, "y": 56, "width": 47, "height": 14 } },
      "h12": { "preset": "choice", "label": "12h", "bounds": { "x": 53, "y": 56, "width": 47, "height": 14 } },
      "result": { "preset": "resultText", "bounds": { "x": 0, "y": 74, "width": 100, "height": 18 } },
