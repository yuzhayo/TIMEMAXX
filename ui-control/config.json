      "geometry": { "borderWidth": 1, "radius": 4, "fontSize": 13 }, "bounds": { "width": 100, "height": 28 },
      "states": { "focusVisible": { "colors": { "outline": "#ffc44d" }, "geometry": { "outlineWidth": 1 } } },
