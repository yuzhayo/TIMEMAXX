      "monthName": { "preset": "choice", "label": "DD MONTH YYYY", "bounds": { "x": 0, "y": 58, "width": 100, "height": 14 } },
      "result": { "preset": "resultText", "bounds": { "x": 0, "y": 74, "width": 100, "height": 18 } },
      "copy": { "preset": "secondaryAction", "label": "Copy date", "bounds": { "x": 0, "y": 93, "width": 40, "height": 7 } },
      "status": { "preset": "captionText", "bounds": { "x": 42, "y": 93, "width": 58, "height": 7 } }
