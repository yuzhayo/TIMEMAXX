        "title": { "preset": "base", "bounds": { "width": 82, "height": 100 }, "typography": { "weight": 600 } },
        "icon": { "preset": "base", "bounds": { "width": 12, "height": 60 }, "name": "expandMore", "rotation": { "closed": 0, "open": 180 } }
      }
    },
