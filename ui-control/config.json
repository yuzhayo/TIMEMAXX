{
  "schemaVersion": 1,
  "window": {
    "title": "TimeMaxx Input",
    "units": "DIP",
    "frame": false,
    "thickFrame": false,
    "width": { "base": "frame", "percent": 40 },
    "height": { "base": "workArea", "percent": 100 },
    "placement": { "x": "beforeFrame", "y": "workAreaStart" },
    "background": "#111418"
  },
  "presets": {
    "base": {
      "colors": { "background": "transparent", "foreground": "#e4e9ef", "border": "transparent", "outline": "transparent" },
      "geometry": { "paddingX": 0, "paddingY": 0, "gap": 0, "radius": 0, "borderWidth": 0, "borderStyle": "solid", "outlineWidth": 0, "outlineStyle": "solid", "outlineOffset": 0, "fontSize": 14, "lineHeight": 1.3, "letterSpacing": 0, "opacity": 1, "shadow": "none", "transition": "none" },
      "typography": { "family": "\"Segoe UI\", system-ui, sans-serif", "weight": 400 },
      "content": { "direction": "row", "verticalAlign": "center", "horizontalAlign": "flex-start", "textAlign": "left", "whiteSpace": "normal", "overflow": "hidden", "wrap": "nowrap", "overflowWrap": "normal" },
      "states": {}
    },
    "root": { "preset": "base", "colors": { "background": "#111418" }, "geometry": { "paddingX": 4, "paddingY": 0.5 }, "content": { "direction": "column", "verticalAlign": "flex-start", "horizontalAlign": "stretch" } },
    "diagnostic": { "preset": "base", "colors": { "foreground": "#ffe2a0" }, "geometry": { "fontSize": 10, "paddingY": 0.5 }, "content": { "overflow": "auto", "overflowWrap": "anywhere" } },
    "inspection": { "preset": "base", "colors": { "border": "#ffc44d", "foreground": "#ffc44d" }, "geometry": { "borderWidth": 1, "fontSize": 8 }, "content": { "verticalAlign": "flex-start", "whiteSpace": "normal" } }
  },
  "root": { "id": "inputRoot", "preset": "root" },
  "diagnostics": { "preset": "diagnostic", "height": 8 },
  "development": { "inspectionEnabled": false, "inspector": { "preset": "inspection", "zIndex": 10 } },
  "sections": [],
  "languages": [],
  "layouts": {}
}
