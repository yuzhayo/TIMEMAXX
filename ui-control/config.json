    },
    "primaryAction": {
      "preset": "base", "colors": { "background": "#ffc44d", "foreground": "#0a0a0a" },
      "geometry": { "radius": 4, "fontSize": 12 }, "typography": { "weight": 700 },
      "content": { "horizontalAlign": "center", "textAlign": "center" },
      "states": {
        "hover": { "colors": { "background": "#ffd166" } },
        "focusVisible": { "colors": { "outline": "#ffc44d" }, "geometry": { "outlineWidth": 1 } },
        "disabled": { "colors": { "background": "#303842", "foreground": "#687381" } }
