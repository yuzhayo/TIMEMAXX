      "content": { "horizontalAlign": "center", "textAlign": "center" }
    },
    "timeField": {
      "preset": "base", "colors": { "background": "#1d252f", "foreground": "#e4e9ef", "border": "#43505f" },
      "geometry": { "borderWidth": 1, "radius": 4, "fontSize": 13 },
